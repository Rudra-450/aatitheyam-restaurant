PROJECT_NAME="Aatitheyam Cafe & Bhojnalaya"
API_V1_PREFIX=/api/v1
SECRET_KEY="replace-this-with-a-secure-random-32-byte-hex-string"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=restaurant_owner_session
COOKIE_SECURE=false

