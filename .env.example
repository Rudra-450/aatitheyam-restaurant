# Root Environment Example
PROJECT_NAME="Aatitheyam Cafe & Bhojnalaya"
API_V1_PREFIX=/api/v1
SECRET_KEY="super-secret-production-grade-key-change-in-env-file-at-least-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=restaurant_owner_session
COOKIE_SECURE=true

# PostgreSQL Production URL:
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/restaurant_db

# Public Menu URL for QR code generation
PUBLIC_MENU_BASE_URL=https://your-domain.com/menu
